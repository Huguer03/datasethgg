library(ggplot2)
library(plotly)
library(e1071)
datosX <- read.csv("datos/X_laboratorio_AAA.csv")
datosY <- read.csv("datos/y_laboratorio_AAA.csv")
X <- as.matrix(datosX, ncol=3)
Y <- as.numeric(datosY$X.1)
y <- as.factor(as.matrix(datosY, ncol=1))
datos <- data.frame(x1=X[,1], x2=X[,2], x3=X[,3], y=y)
dp <- data.frame(x1=X[,1], x2=X[,2])
ggplot(dp, aes(x=x1, y=x2, col=y)) + geom_point()
C <- 1e7
modelo <- svm(y~., data=datos, kernel="linear", cost=C, scale=F, shrinking=F, probability=F)
modelo
plot(modelo, datos, formula=x3~x1)
w <- t(modelo$coefs) %*% modelo$SV
b <- -modelo$rho
modelo$SV
sup_vect <- as.factor(ifelse(Y * (X%*%t(w) + b) <= 1, "Suport Vector", "Normal point"))
sum(sup_vect=="Suport Vector")
which(sup_vect=="Suport Vector")
r1 <- range(datos$x1)
r2 <- range(datos$x2)
xs <- seq(r1[1], r1[2], length.out = 50)
ys <- seq(r2[1], r2[2], length.out = 50)
# Resolver el plano para z (x3) suponiendo w[3] != 0
grid <- expand.grid(x1 = xs, x2 = ys)
grid$z <- -(w[,1] * grid$x1 + w[,2] * grid$x2 + b) / w[,3]
zmat <- matrix(grid$z, nrow = length(xs))
# Ahora para conseguir los planos marginales:
# Plano positivo
marginal_pos <- expand.grid(x1 = xs, x2 = ys)
marginal_pos$z <- -(w[,1] * grid$x1 + w[,2] * grid$x2 + b + 1 + 0.00001) / w[,3]
zmat_pos <- matrix(marginal_pos$z, nrow = length(xs))
# Plano negativo
marginal_neg <- expand.grid(x1 = xs, x2 = ys)
marginal_neg$z <- -(w[,1] * grid$x1 + w[,2] * grid$x2 + b - 1 - 0.00001) / w[,3]
zmat_neg <- matrix(marginal_neg$z, nrow = length(xs))
df <- data.frame(x1 = datos$x1, x2 = datos$x2, x3 = datos$x3,
y  = sup_vect)
plot_ly(df,
x = ~x1, y = ~x2, z = ~x3,
color = ~y,
colors = c("steelblue", "firebrick"),
type = "scatter3d", mode = "markers",
marker = list(size = 4, opacity = 0.85)) %>%
add_surface(x = xs, y = ys, z = zmat,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("grey","grey")))%>%
add_surface(x = xs, y = ys, z = zmat_pos,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("coral","purple")))%>%
add_surface(x = xs, y = ys, z = zmat_neg,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("blue","purple")))
sup_vect <- as.factor(ifelse(Y * (X%*%t(w) + b) <= 1 + 0.01, "Suport Vector", "Normal point"))
sum(sup_vect=="Suport Vector")
which(sup_vect=="Suport Vector")
