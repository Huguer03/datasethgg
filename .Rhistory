library(ggplot2)
library(plotly)
datosX <- read.csv("datos/X_laboratorio_AAA.csv")
datosY <- read.csv("datos/y_laboratorio_AAA.csv")
X <- as.matrix(datosX[,1:2], ncol=2)
Y <- as.numeric(datosY$X.1)
y <- as.factor(as.matrix(datosY, ncol=1))
dp <- data.frame(x1=X[,1], x2=X[,2])
ggplot(dp, aes(x=x1, y=x2, col=y)) + geom_point()
gradient_step <- function(X, Y, lambda, w) {
aux <- colSums(- sweep(X,1,Y,"*") / (1 + exp(rowSums(w * X) * Y)))
grad <- aux / nrow(X) + 2 * lambda * w
return(grad)
}
iter <- 500
w <- runif(2, -0.5, 0.5)
w_vec <- matrix(0,ncol=2, nrow=iter)
for (i in 1:iter) {
w_vec[i,] <- w
w <- w - 0.1 * gradient_step(X, Y, 1, w)
}
w_vec[iter,] <- w
w
log_loss <- function(X, Y, lambda, w) {
n <- nrow(X)
aux <- 0
for (i in 1:n) {
z <- sum(w * X[i, ])
aux <- aux + log(1 + exp(Y[i] * z))
}
loss <- aux / n + lambda * sqrt(sum(w^2))
return(loss)
}
epoc <- 1:iter
loss <- 1:iter
for (i in 1:iter){
loss[i] <- log_loss(X=X , Y=Y, lambda=0, w=w_vec[i,])
}
dp <- data.frame(iter=epoc, loss=loss)
ggplot(dp, aes(x=iter, y=loss)) + geom_line()
epoc <- 1:iter
loss <- 1:iter
for (i in 1:iter){
loss[i] <- log_loss(X=X , Y=Y, lambda=1, w=w_vec[i,])
}
dp <- data.frame(iter=epoc, loss=loss)
ggplot(dp, aes(x=iter, y=loss)) + geom_line()
acuracy <- function(X, Y, W) {
N <- nrow(W)
n <- nrow(X)
err <- 1:N
for (i in 1:N) {
e <- 0
for (j in 1:n) {
pred <- sign(sum(W[i, ] * X[j, ]))
if (pred != Y[j]) e <- e + 1
}
err[i] <- e / n
}
data.frame(epoca = 1:N, err = err)
}
dp <- acuracy(X,Y,w_vec)
ggplot(dp, aes(x=epoca, y=err)) + geom_line()
phi <- function(x){
x1 <- x[1]
x2 <- x[2]
return(c(x1, x2, x1^2 + x2^2 - 0.5))
}
phiX <- t(apply(X, 1, phi))
dp <- data.frame(x1=phiX[,1], x2=phiX[,2], x3=phiX[,3], y=y)
plot_ly(
dp,
x = ~x1, y = ~x2, z = ~x3,
color = ~y,
colors = c("steelblue", "firebrick"),
type = "scatter3d",
mode = "markers",
marker = list(size = 4, opacity = 0.85)
)
iter <- 500
w <- runif(3, -0.5, 0.5)
for (i in 1:iter) {
w <- w - 0.1 * gradient_step(phiX, Y, 1, w)
}
w
r1 <- range(phiX[, 1])
r2 <- range(phiX[, 2])
xs <- seq(r1[1], r1[2], length.out = 50)
ys <- seq(r2[1], r2[2], length.out = 50)
# Resolver el plano para z (x3) suponiendo w[3] != 0
grid <- expand.grid(x1 = xs, x2 = ys)
grid$z <- -(w[1] * grid$x1 + w[2] * grid$x2) / w[3]
zmat <- matrix(grid$z, nrow = length(xs))
df <- data.frame(x1 = phiX[,1], x2 = phiX[,2], x3 = phiX[,3],
y  = y)
plot_ly(df,
x = ~x1, y = ~x2, z = ~x3,
color = ~y,
colors = c("steelblue", "firebrick"),
type = "scatter3d", mode = "markers",
marker = list(size = 4, opacity = 0.85)) %>%
add_surface(x = xs, y = ys, z = zmat,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("grey","grey")),
name = "plano w·φ(x)=0")
gradient_step_c <- function(X, Y, lambda, c) {
aux <- -Y / (1 + exp(Y * X%*%t(X)*c))
grad <- aux / nrow(X) + 2 * lambda * c
return(grad)
}
repres_TMA <- function(X,c){
w <- rowSums(t(X)*c)
return(w)
}
iter <- 500
c <- runif(nrow(X),0,1)
for (i in 1:iter) {
c <- c - 0.1 * gradient_step(phiX, Y, 1, c)
}
w <- repres_TMA(phiX,c)
w
r1 <- range(phiX[, 1])
r2 <- range(phiX[, 2])
xs <- seq(r1[1], r1[2], length.out = 50)
ys <- seq(r2[1], r2[2], length.out = 50)
# Resolver el plano para z (x3) suponiendo w[3] != 0
grid <- expand.grid(x1 = xs, x2 = ys)
grid$z <- -(w[1] * grid$x1 + w[2] * grid$x2) / w[3]
zmat <- matrix(grid$z, nrow = length(xs))
df <- data.frame(x1 = phiX[,1], x2 = phiX[,2], x3 = phiX[,3],
y  = y)
plot_ly(df,
x = ~x1, y = ~x2, z = ~x3,
color = ~y,
colors = c("steelblue", "firebrick"),
type = "scatter3d", mode = "markers",
marker = list(size = 4, opacity = 0.85)) %>%
add_surface(x = xs, y = ys, z = zmat,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("grey","grey")))
grad_w <- function(X,Y,w,b,lambda=0){
n <- nrow(X)
sig <- as.logical(Y * (X%*%w + b) >= 1)
grad <- 2*lambda*w
for (i in 1:n){
if(!sig[i]) grad <- grad - (Y[i] * X[i, ]) / n
}
return(grad)
}
grad_b <- function(X,Y,w,b){
n <- nrow(X)
sig <- as.logical(Y * (X%*%w + b) >= 1)
grad <- 0
for (i in 1:n){
if(!sig[i]) grad <- grad - Y[i] / n
}
return(grad)
}
iter <- 10000
b <- runif(1,-0.2,0)
w <- runif(3,-0.5,0.5)
rate <- 1
for (i in 1:iter){
w0 <- w
w <- w0 - rate * grad_w(phiX,Y,w0,b,lambda=0.0001) / sqrt(i)
b <- b - rate * grad_b(phiX,Y,w0,b) / sqrt(i)
}
r1 <- range(phiX[, 1])
r2 <- range(phiX[, 2])
xs <- seq(r1[1], r1[2], length.out = 50)
ys <- seq(r2[1], r2[2], length.out = 50)
# Resolver el plano para z (x3) suponiendo w[3] != 0
grid <- expand.grid(x1 = xs, x2 = ys)
grid$z <- -(w[1] * grid$x1 + w[2] * grid$x2 + b) / w[3]
zmat <- matrix(grid$z, nrow = length(xs))
df <- data.frame(x1 = phiX[,1], x2 = phiX[,2], x3 = phiX[,3],
y  = y)
plot_ly(df,
x = ~x1, y = ~x2, z = ~x3,
color = ~y,
colors = c("steelblue", "firebrick"),
type = "scatter3d", mode = "markers",
marker = list(size = 4, opacity = 0.85)) %>%
add_surface(x = xs, y = ys, z = zmat,
opacity = 0.35, showscale = FALSE,
colorscale = list(c(0,1), c("grey","grey")))
